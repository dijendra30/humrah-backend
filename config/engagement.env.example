# -----------------------------------------------------------------------------
# Personal Engagement Notifications — environment variables (Phase 1 + Phase 2)
#
# Example only. Every variable is optional; the values shown are the built-in defaults
# unless marked otherwise. Never commit real keys. In production, set these in Coolify.
# The repository has no other .env example, so this file documents only this feature.
# -----------------------------------------------------------------------------

# ── Phase 1: notification worker (OFF by default) ──────────────────────────────
ENGAGEMENT_WORKER_ENABLED=false
ENGAGEMENT_PLANNER_ENABLED=true
ENGAGEMENT_QUEUE_ENABLED=true
ENGAGEMENT_INTERVAL_SECONDS=300
ENGAGEMENT_BATCH_SIZE=100
ENGAGEMENT_MAX_BATCHES_PER_TICK=3
ENGAGEMENT_MAX_SENDS_PER_TICK=100
ENGAGEMENT_CYCLE_REST_MINUTES=360
ENGAGEMENT_LEASE_SECONDS=240
ENGAGEMENT_CLAIM_LEASE_SECONDS=120
ENGAGEMENT_ORPHAN_RESERVATION_MINUTES=15
ENGAGEMENT_FREQUENCY_HOURS=72
ENGAGEMENT_MAX_ATTEMPTS=4
ENGAGEMENT_RETRY_DELAYS_SECONDS=60,300,900
ENGAGEMENT_MAX_DEFER_HOURS=36
ENGAGEMENT_QUIET_HOURS_ENABLED=true
ENGAGEMENT_QUIET_START=22:00
ENGAGEMENT_QUIET_END=08:00
ENGAGEMENT_DEFAULT_TIMEZONE=Asia/Kolkata
ENGAGEMENT_CATEGORIES_ENABLED=NEARBY,COMMUNITY,SPORTS,ROOMS
ENGAGEMENT_CATEGORY_PRIORITIES=SPORTS:90,ROOMS:80,COMMUNITY:75,NEARBY:70,SEASONAL:50,SOCIAL:45,INFORMATIVE:40,FUNNY:30
ENGAGEMENT_RADIUS_KM=10
ENGAGEMENT_LOCATION_MAX_AGE_DAYS=30
ENGAGEMENT_NEW_MEMBERS_DAYS=7
ENGAGEMENT_NEW_MEMBERS_MIN=3
ENGAGEMENT_SPORTS_MIN_LEAD_MINUTES=120
ENGAGEMENT_SPORTS_MAX_LEAD_HOURS=72
ENGAGEMENT_ROOM_ACTIVE_HOURS=48
ENGAGEMENT_QUESTION_MAX_AGE_HOURS=18
ENGAGEMENT_QUESTION_MIN_REMAINING_HOURS=3

# ── Phase 2: template selection (used by the worker; no AI involved) ───────────
# Built-ins = the reviewed Phase 1 English copy, kept as the safe fallback.
ENGAGEMENT_BUILTIN_TEMPLATES_ENABLED=true
# en_only keeps Phase 1 behaviour. preferred: English only → en, Hindi only → hi,
# Hindi + English → hinglish (from the languages a user says they speak).
ENGAGEMENT_LANGUAGE_MODE=en_only

# ── Phase 2: AI template generation (OFF by default) ──────────────────────────
# Master switch for ANY provider call (manual or scheduled). Delivery never needs it.
ENGAGEMENT_AI_ENABLED=false
# Scheduled generation also needs this (manual generation through the admin API does not).
ENGAGEMENT_AI_SCHEDULE_ENABLED=false
ENGAGEMENT_AI_SCHEDULE_INTERVAL_HOURS=24
ENGAGEMENT_AI_SCHEDULE_LANGUAGES=en
ENGAGEMENT_AI_TARGET_POOL_SIZE=6
ENGAGEMENT_AI_MAX_BATCHES_PER_RUN=2

# Providers. Dedicated keys for this feature only (never GEMINI_API_KEY / GROQ_API_KEY).
ENGAGEMENT_AI_PRIMARY_PROVIDER=gemini
# gemini | groq | none
ENGAGEMENT_AI_FALLBACK_PROVIDER=groq
# REQUIRED to use Gemini (no default):
ENGAGEMENT_AI_GEMINI_API_KEY=
ENGAGEMENT_AI_GEMINI_MODEL=gemini-2.5-flash-lite
ENGAGEMENT_AI_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
ENGAGEMENT_AI_GEMINI_DAILY_REQUEST_CAP=50
ENGAGEMENT_AI_GEMINI_MIN_INTERVAL_SECONDS=5
# REQUIRED to use Groq (no defaults for key or model):
ENGAGEMENT_AI_GROQ_API_KEY=
ENGAGEMENT_AI_GROQ_MODEL=
ENGAGEMENT_AI_GROQ_BASE_URL=https://api.groq.com
ENGAGEMENT_AI_GROQ_DAILY_REQUEST_CAP=50
ENGAGEMENT_AI_GROQ_MIN_INTERVAL_SECONDS=5

# Resilience
ENGAGEMENT_AI_TIMEOUT_SECONDS=20
ENGAGEMENT_AI_MAX_ATTEMPTS=2
ENGAGEMENT_AI_RETRY_BASE_MS=1000
ENGAGEMENT_AI_RATE_LIMIT_COOLDOWN_SECONDS=120
ENGAGEMENT_AI_QUOTA_COOLDOWN_MINUTES=360
ENGAGEMENT_AI_AUTH_COOLDOWN_MINUTES=720
ENGAGEMENT_AI_FAILURE_COOLDOWN_MINUTES=15
ENGAGEMENT_AI_FAILURE_THRESHOLD=3

# Generation
ENGAGEMENT_AI_MAX_BATCH_SIZE=8
ENGAGEMENT_AI_TITLE_MAX=60
ENGAGEMENT_AI_BODY_MAX=140
ENGAGEMENT_AI_TEMPERATURE_PERCENT=90
ENGAGEMENT_AI_MAX_OUTPUT_TOKENS=2048
ENGAGEMENT_AI_DEFAULT_LANGUAGE=en
# manual: new templates are DRAFT. auto_approve: APPROVED (still need activation). Nothing auto-activates.
ENGAGEMENT_AI_APPROVAL_POLICY=manual
ENGAGEMENT_AI_REGEN_MIN_HOURS=72
ENGAGEMENT_AI_LOCK_SECONDS=300
ENGAGEMENT_AI_SIMILARITY_PERCENT=75
